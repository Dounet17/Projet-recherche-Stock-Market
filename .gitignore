# Environnements virtuels et secrets
.env
venv/
env/
.venv-forecast/

# Fichiers de cache Python
__pycache__/
*.py[cod]
*$py.class

# Dossiers de données (jamais versionnés)
data/
results/metrics/*
results/figures/*
!results/metrics/.gitkeep
!results/figures/.gitkeep
*.pkl
*.h5

# Fichiers Jupyter Notebook
.ipynb_checkpoints/

# Fichiers système et configuration d'éditeurs
.vscode/
.idea/
.DS_Store

# Poids des modèles d'IA
*.pt
*.bin
*.safetensors

# Résultats de calcul volumineux, régénérables par les scripts de reports/
reports/**/chunks/
reports/lab_2026-11/trials/
reports/**/*.parquet
web/site_data.js
vault/

# Journaux d'exécution locaux
*.log
